# Multiple dominating failed checks create exclusions.
# check1 (klass 6): no base type, preserved.
IsObjectKlass 6 = false
# check2 (klass 10): sharpenFromDominators finds exclusion {6}.
#   TCE: IsSubtype(10, 6)? No → preserved.
IsObjectKlass 10 = false
IsSubtype 10 6 = false
# check3 (klass 11): sharpenFromDominators builds ExcludedKlasses={10, 6}.
IsObjectKlass 11 = false
#   sharpenFromDominators addExcludedKlass({10}, 6):
IsSubtype 6 10 = false
IsSubtype 10 6 = false
#   typeIntersect → unionExcludedKlasses({}, set) iterates: 6, 10.
#   addExcludedKlass(empty, 6): no VM calls.
#   addExcludedKlass({6}, 10):
IsSubtype 10 6 = false
IsSubtype 6 10 = false
#   TCE exclusion loop (iterates 6, 10):
#   IsSubtype(11, 6)=false (ArrayList not subtype of Animal)
IsSubtype 11 6 = false
#   IsSubtype(11, 10)=true (ArrayList subtype of AbstractList) => fold to false.
IsSubtype 11 10 = true
